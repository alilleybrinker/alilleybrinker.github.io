---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import ThemeSwitcher from '../components/ThemeSwitcher.astro';
import CommandPalette from '../components/CommandPalette.astro';
import LinkPreviews from '../components/LinkPreviews.astro';
import DitherField from '../components/DitherField.astro';
import PostTitleTransitions from '../components/PostTitleTransitions.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Icon from '../components/Icon.astro';
import standardSite from '../data/standard-site.json';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  feed?: string;
  type?: 'website' | 'article';
  structuredData?: Record<string, unknown>;
  socialImage?: string;
  socialImageAlt?: string;
  standardDocumentUri?: string;
  markdown?: string;
  // Keeps search engines from listing the page, as for unlisted posts.
  noindex?: boolean;
  // Draws the page's dither field broken apart (DitherField.astro).
  field?: 'scattered';
}
const {
  title: pageTitle,
  description = 'I’m a Member of Technical Staff at Anthropic. I write about software security, memory safety, Rust, and open source.',
  canonical = new URL(Astro.url.pathname, Astro.site),
  feed = '/rss.xml',
  type = 'website',
  structuredData,
  socialImage: pageSocialImage = '/social/home.png',
  socialImageAlt = 'Andrew Lilley Brinker',
  standardDocumentUri,
  markdown,
  noindex = false,
  field,
} = Astro.props;
const title = pageTitle ? `${pageTitle} — Andrew Lilley Brinker` : 'Andrew Lilley Brinker';
const socialImage = new URL(pageSocialImage, Astro.site);
const personImage = new URL('/image/andrew.png', Astro.site);
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Andrew Lilley Brinker',
  url: new URL('/', Astro.site).href,
  image: personImage.href,
  jobTitle: 'Member of Technical Staff',
  worksFor: {
    '@type': 'Organization',
    name: 'Anthropic',
    url: 'https://www.anthropic.com/',
  },
  sameAs: [
    'https://bsky.app/profile/alilleybrinker.com',
    'https://github.com/alilleybrinker',
    'https://hachyderm.io/@alilleybrinker',
    'https://www.linkedin.com/in/alilleybrinker',
  ],
};
const jsonLd = (data: Record<string, unknown>) => JSON.stringify(data).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="en-US" data-field={field}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      const applyStoredTheme = (root = document.documentElement) => {
        const storedTheme = localStorage.getItem('theme');
        const theme = storedTheme === 'light' || storedTheme === 'dark'
          ? storedTheme
          : matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        root.classList.toggle('dark', theme === 'dark');
      };
      applyStoredTheme();
      // Client-side navigation replaces the root element's classes with the
      // incoming page's, so apply the theme before the new page is shown.
      document.addEventListener('astro:before-swap', (event) => applyStoredTheme(event.newDocument.documentElement));
      // Pages print in the light theme, whichever is on screen.
      addEventListener('beforeprint', () => document.documentElement.classList.remove('dark'));
      addEventListener('afterprint', () => applyStoredTheme());
    </script>
    <ClientRouter />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Andrew Lilley Brinker" />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:secure_url" content={socialImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1356" />
    <meta property="og:image:height" content="628" />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <link rel="alternate" type="application/rss+xml" title="RSS" href={feed} />
    {markdown && <link rel="alternate" type="text/markdown" title="Markdown" href={markdown} />}
    {standardSite.publicationUri && <link rel="site.standard.publication" href={standardSite.publicationUri} />}
    {standardDocumentUri && <link rel="site.standard.document" href={standardDocumentUri} />}
    <!-- 100% privacy-first analytics -->
    <script data-collect-dnt="true" async src="https://scripts.simpleanalyticscdn.com/latest.js"></script>
    <script type="application/ld+json" set:html={jsonLd(person)} />
    {structuredData && <script type="application/ld+json" set:html={jsonLd(structuredData)} />}
  </head>
  <body class="bg-stone-50 dark:bg-neutral-900">
    <a href="#content" class="sr-only rounded-full bg-white text-sm focus:px-4 focus:py-2 text-black shadow-[0_12px_32px_-16px_rgb(0_0_0/0.25)] ring-1 ring-black/5 focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-70 dark:bg-neutral-800 dark:text-white dark:ring-white/10">Skip to content</a>
    <DitherField />
    <noscript><img src="https://queue.simpleanalyticscdn.com/noscript.gif?collect-dnt=true" alt="" referrerpolicy="no-referrer-when-downgrade" /></noscript>
    <div class="subpixel-antialiased overflow-x-clip">
      <header transition:name="site-header" transition:animate="none" class="relative z-20 pt-8 pb-0 mb-4 text-black dark:text-neutral-100 text-base md:pt-16 md:text-lg px-5 md:px-0 md:max-w-(--breakpoint-md) md:mx-auto">
        <nav class="flex items-center gap-2 font-normal" aria-label="Primary navigation">
          <a href="/" class="site-logo inline-flex min-w-0 items-center gap-2 whitespace-nowrap leading-none hover:underline font-semibold">
            <span class="relative size-12 shrink-0 md:size-16 md:-ml-[4.5rem]">
              <span aria-hidden="true" class="site-logo-backdrop absolute inset-0 rounded-full dark:bg-neutral-300"></span>
              <span aria-hidden="true" class="site-logo-face"></span>
              <span aria-hidden="true" class="site-logo-face site-logo-face-hover"></span>
            </span>
            <span class="truncate">Andrew Lilley Brinker</span>
          </a>
          <a href="/about/" class="hidden md:ml-4 md:inline-flex md:items-center leading-none hover:underline">About</a>
          <a href="/reading/" class="hidden md:ml-4 md:inline-flex md:items-center leading-none hover:underline">Reading</a>
          <a href="/projects/" class="hidden md:ml-4 md:inline-flex md:items-center leading-none hover:underline">Projects</a>
          <div class="ml-auto hidden shrink-0 items-center gap-2 md:-mr-6 md:flex">
            <button type="button" data-command-palette-open aria-keyshortcuts="Meta+K Control+K /" class="mr-1 flex h-8 cursor-pointer items-center gap-2 rounded-full bg-neutral-500/10 pl-3 pr-2 text-sm text-neutral-600 hover:bg-neutral-500/15 hover:text-black dark:text-muted dark:hover:text-white">
              <svg aria-hidden="true" viewBox="0 0 20 20" class="size-4" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><circle cx="8.5" cy="8.5" r="5.75" /><path d="m13 13 4.25 4.25" /></svg>
              <span class="sr-only">Search</span>
              <span data-command-palette-shortcut class="rounded-full bg-neutral-500/10 px-1.5 text-xs leading-5">⌘K</span>
            </button>
            <a href="https://bsky.app/profile/alilleybrinker.com" aria-label="Bluesky" class="flex size-8 items-center justify-center text-neutral-400 hover:text-neutral-500"><Icon name="bluesky" class="!h-5 !w-5" /></a>
            <a href="https://github.com/alilleybrinker" aria-label="GitHub" class="flex size-8 items-center justify-center text-neutral-400 hover:text-neutral-500"><Icon name="github" class="!h-5 !w-5" /></a>
            <ThemeSwitcher />
          </div>
          <div class="ml-auto flex items-center gap-2 md:hidden">
            <button type="button" data-command-palette-open aria-label="Search" class="flex size-8 cursor-pointer items-center justify-center rounded-full bg-neutral-500/10 text-neutral-600 hover:bg-neutral-500/15 hover:text-black dark:text-muted dark:hover:text-white">
              <svg aria-hidden="true" viewBox="0 0 20 20" class="size-4" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><circle cx="8.5" cy="8.5" r="5.75" /><path d="m13 13 4.25 4.25" /></svg>
            </button>
            <details class="group relative">
              <summary class="flex h-8 cursor-pointer list-none items-center gap-1.5 rounded-full bg-neutral-500/10 px-3.5 text-sm text-neutral-600 dark:text-muted hover:bg-neutral-500/15 hover:text-black group-open:bg-neutral-500/15 group-open:text-black dark:hover:text-white dark:group-open:text-white [&::-webkit-details-marker]:hidden">
                Menu
                <span aria-hidden="true" class="text-[0.7em] transition-transform duration-150 group-open:rotate-180 motion-reduce:transition-none">▾</span>
              </summary>
              <ul class="absolute right-0 z-10 mt-2 min-w-48 list-none rounded-3xl bg-white p-1.5 text-base shadow-[0_12px_32px_-16px_rgb(0_0_0/0.25)] ring-1 ring-black/5 dark:bg-neutral-800 dark:ring-white/10">
                <li><a href="/about/" class="block rounded-full px-4 py-2 hover:bg-neutral-500/10">About</a></li>
                <li><a href="/reading/" class="block rounded-full px-4 py-2 hover:bg-neutral-500/10">Reading</a></li>
                <li><a href="/projects/" class="block rounded-full px-4 py-2 hover:bg-neutral-500/10">Projects</a></li>
                <li class="flex items-center gap-1 px-2.5 pb-1">
                  <a href="https://bsky.app/profile/alilleybrinker.com" aria-label="Bluesky" class="flex size-8 items-center justify-center rounded-full text-neutral-400 hover:bg-neutral-500/10 hover:text-neutral-500"><Icon name="bluesky" class="!h-5 !w-5" /></a>
                  <a href="https://github.com/alilleybrinker" aria-label="GitHub" class="flex size-8 items-center justify-center rounded-full text-neutral-400 hover:bg-neutral-500/10 hover:text-neutral-500"><Icon name="github" class="!h-5 !w-5" /></a>
                  <ThemeSwitcher />
                </li>
              </ul>
            </details>
          </div>
        </nav>
      </header>
      <main id="content" tabindex="-1" class="outline-none pt-12 pb-24 px-5 md:px-0 md:max-w-(--breakpoint-md) md:mx-auto"><div class="prose lg:prose-lg site-prose"><slot /></div></main>
      <SiteFooter />
    </div>
    <LinkPreviews />
    <CommandPalette />
    <PostTitleTransitions />
  </body>
</html>

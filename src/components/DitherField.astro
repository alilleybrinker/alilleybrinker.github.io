---
// A dithered field across the top of every page, in the same 4×4 ordered
// dither as the project plates and the About photo. It drifts slowly, gathers
// and warms toward the signal orange near the cursor, and each page has its own,
// seeded from its path, so moving between pages morphs one into the next. A
// page can ask for its field scattered, as the 404 page does, with
// data-field="scattered" on its root. A
// fragment shader draws it (src/lib/dither-field.ts), in a worker where the
// browser can, so the page's main thread only passes events along. Each page
// has its own canvas; the field's state carries over from one to the next. It
// stops when scrolled out of view, holds still for reduced motion, and is
// absent without WebGL.
---

<canvas id="dither-field" aria-hidden="true"></canvas>

<script>
  import { createField, type Message } from '../lib/dither-field';

  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');
  const scattered = () => document.documentElement.dataset.field === 'scattered';

  // The worker draws when the browser can hand it a canvas; otherwise the
  // field draws here. Either way, `send` passes it what it needs to know, and
  // `attach` gives it each page's canvas.
  let send: (message: Message) => void;
  let attach: (canvas: HTMLCanvasElement) => boolean;

  // During a move between pages, the old page's field holds (see
  // ::view-transition-old(dither-field) in global.css) until the new page's
  // field has drawn, then fades, so the field never blinks out while the new
  // canvas is still blank. The new field starts as the old one's shape.
  const drawn = () => {
    try {
      document.documentElement.animate({ opacity: [1, 0] }, { duration: 200, easing: 'ease-out', fill: 'forwards', pseudoElement: '::view-transition-old(dither-field)' });
    } catch {
      // No move between pages under way.
    }
  };
  if ('transferControlToOffscreen' in HTMLCanvasElement.prototype && typeof Worker === 'function') {
    const worker = new Worker(new URL('../lib/dither-field.worker.ts', import.meta.url), { type: 'module' });
    worker.postMessage({ type: 'start', path: location.pathname, scattered: scattered(), reduce: reduceMotion.matches });
    worker.onmessage = (event) => {
      if (event.data.type === 'unavailable') document.querySelector('#dither-field')?.remove();
      else if (event.data.type === 'drawn') drawn();
    };
    send = (message) => worker.postMessage(message);
    attach = (canvas) => {
      const offscreen = canvas.transferControlToOffscreen();
      worker.postMessage({ type: 'attach', canvas: offscreen }, [offscreen]);
      return true;
    };
  } else {
    const field = createField(location.pathname, scattered(), reduceMotion.matches, drawn);
    send = field.send;
    attach = field.attach;
  }

  // Colors come from the page's theme as RGB, through a 2D canvas, which
  // understands any CSS color. The canvas is kept in memory rather than on the
  // GPU: reading back a GPU canvas waits on the GPU, which at page load is
  // busy starting the field, and that held up the page for as long as a second
  // on a slow machine.
  const rgb = (color: string) => {
    const context = Object.assign(document.createElement('canvas'), { width: 1, height: 1 }).getContext('2d', { willReadFrequently: true })!;
    context.fillStyle = color;
    context.fillRect(0, 0, 1, 1);
    const [r, g, b] = context.getImageData(0, 0, 1, 1).data;
    return [r / 255, g / 255, b / 255];
  };
  const sendColors = () => {
    const dark = document.documentElement.classList.contains('dark');
    const signal = getComputedStyle(document.documentElement).getPropertyValue('--color-signal').trim();
    send({ type: 'colors', ink: rgb(dark ? 'oklch(0.27 0 0)' : 'oklch(0.91 0 0)'), hot: rgb(signal || '#f25a00') });
  };
  sendColors();
  new MutationObserver(sendColors).observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
  reduceMotion.addEventListener('change', () => send({ type: 'reduce-motion', reduce: reduceMotion.matches }));

  // The field's height, kept from its last resize, so following the pointer
  // never needs to read layout.
  let height = 0;
  const resizes = new ResizeObserver(([entry]) => {
    height = entry.contentRect.height;
    send({ type: 'size', width: entry.contentRect.width, height });
  });
  // The field draws only while it's on screen and nothing covers the page,
  // such as the command palette, which announces itself with page-cover.
  let onScreen = true;
  let covered = false;
  const sendVisible = () => send({ type: 'visible', visible: onScreen && !covered });
  const visibility = new IntersectionObserver(([entry]) => {
    onScreen = entry.isIntersecting;
    sendVisible();
  });
  document.addEventListener('page-cover', (event) => {
    covered = (event as CustomEvent<boolean>).detail;
    sendVisible();
  });

  // Each page has its own canvas, which the field moves onto as the page
  // arrives. Handing a canvas over takes a few milliseconds, so it waits until
  // the page has drawn once, rather than lengthening the first frame of the
  // move between pages, while the new page's field is still fading in.
  // Two quick moves can both find the newest page's canvas, which can only be
  // handed over once.
  const afterPaint = (callback: () => void) => requestAnimationFrame(() => setTimeout(callback));
  let attached: HTMLCanvasElement | undefined;
  document.addEventListener('astro:page-load', () => afterPaint(() => {
    const canvas = document.querySelector<HTMLCanvasElement>('#dither-field');
    if (!canvas || canvas === attached) return;
    attached = canvas;
    resizes.disconnect();
    visibility.disconnect();
    if (!attach(canvas)) {
      canvas.remove();
      return;
    }
    resizes.observe(canvas);
    visibility.observe(canvas);
  }));

  // The field sits at the top of the page, so the pointer's place in it is
  // its place in the page.
  addEventListener('pointermove', (event) => {
    if (event.pointerType !== 'mouse') return;
    const y = event.clientY + scrollY;
    send({ type: 'pointer', x: event.clientX, y, inside: y < height });
  }, { passive: true });
  document.documentElement.addEventListener('pointerleave', () => send({ type: 'pointer', x: -1e4, y: -1e4, inside: false }));

  // A new page's field grows out of the one on screen.
  document.addEventListener('astro:after-swap', () => send({ type: 'morph', path: location.pathname, scattered: scattered() }));
</script>

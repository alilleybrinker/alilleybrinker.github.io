---
import type { Post } from '../lib/site';
import { postDate, postPath, postReadingTime, publicationColors } from '../lib/site';
import Icon from './Icon.astro';

// One post in a list: its title with its marks, then its date and reading
// time. Its title carries data-post-title, so opening it morphs the title into
// the post's heading (PostTitleTransitions.astro).
interface Props {
  post: Post;
  // Marked with a star, as featured in Start Here.
  featured?: boolean;
  // Whether the date gives the year, for lists not grouped under years.
  withYear?: boolean;
}
const { post, featured = false, withYear = false } = Astro.props;
---

<a class="group flex flex-col items-start gap-1 py-1.5 text-black sm:flex-row sm:items-baseline sm:justify-between sm:gap-6 dark:text-white" href={postPath(post)}>
  <span class="inline-flex items-center gap-1"><span class="dither-underline" data-post-title>{post.data.title}</span>{featured && <><span aria-hidden="true" title="Featured in Start Here" class="text-signal-text">★</span><span class="sr-only"> (featured)</span></>}{post.data.publication && <span title={post.data.publicationTitle} class="relative top-px mx-0.5 rounded-sm bg-stone-200/65 px-1.5 py-0.5 font-sans text-xs font-semibold text-stone-700 group-hover:bg-(--publication-color) group-hover:text-white dark:bg-neutral-500/70 dark:text-neutral-200" style={`--publication-color: ${publicationColors[post.data.publication]}`}>{post.data.publication}</span>}{post.data.externalUrl && <><Icon name="arrow-up-right" class="!h-4 !w-4 text-neutral-400 group-hover:text-black dark:text-neutral-500 dark:group-hover:text-white" /><span class="sr-only"> (external article)</span></>}</span>
  <time class="shrink-0 text-sm tabular-nums text-muted" datetime={postDate(post).toISOString()}>{postDate(post).toLocaleDateString('en-US', withYear ? { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' } : { month: 'short', day: 'numeric', timeZone: 'UTC' })} / {postReadingTime(post)} min read</time>
</a>

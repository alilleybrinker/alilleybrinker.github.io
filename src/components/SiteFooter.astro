---
import { getCollection } from 'astro:content';
import Icon from './Icon.astro';
import { byNewest, isListedPost, postPath } from '../lib/site';

// The footer at the bottom of every page, set on a band of its own: who writes
// the site, where to follow along, where to go next, and the fine print.
const latest = (await getCollection('blog')).filter(isListedPost).sort(byNewest)[0];
const latestPath = latest && postPath(latest);
const showLatest = latest && latestPath !== Astro.url.pathname;

const follow = [
  { label: 'RSS', href: '/rss.xml' },
  { label: 'Atom', href: '/atom.xml' },
  { label: 'Reading feed', href: '/reading/rss.xml' },
  { label: 'Bluesky', href: 'https://bsky.app/profile/alilleybrinker.com' },
  { label: 'Mastodon', href: 'https://hachyderm.io/@alilleybrinker' },
  { label: 'GitHub', href: 'https://github.com/alilleybrinker' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/alilleybrinker' },
];
const browse = [
  { label: 'Posts', href: '/' },
  { label: 'Topics', href: '/topics/' },
  { label: 'Projects', href: '/projects/' },
  { label: 'Talks', href: '/talks/' },
  { label: 'Reading', href: '/reading/' },
  { label: 'About', href: '/about/' },
];
const label = 'mb-3 text-xs font-semibold uppercase tracking-widest text-neutral-600 dark:text-muted';
const link = 'text-black hover:underline dark:text-neutral-100';
const fine = 'whitespace-nowrap underline decoration-rule hover:text-black dark:hover:text-white';
---

<footer transition:name="site-footer" transition:animate="none" class="site-footer bg-footer text-sm leading-6">
  <div class="grid gap-10 px-5 pt-12 pb-10 md:mx-auto md:max-w-(--breakpoint-md) md:grid-cols-[1fr_auto_auto] md:gap-16 md:px-0">
    <section aria-labelledby="footer-about-heading">
      <h2 id="footer-about-heading" class="font-display text-lg font-semibold tracking-tight text-black dark:text-neutral-100">Andrew Lilley Brinker</h2>
      <p class="mt-2 max-w-[34ch] text-neutral-600 dark:text-muted">I’m a Member of Technical Staff at Anthropic. I write about software security, memory safety, Rust, and open source.</p>
      {showLatest && (
        <p class="mt-5">
          <span class={`${label} mb-1 block`}>Latest</span>
          <a href={latestPath} class={link}>{latest.data.title}</a>
        </p>
      )}
    </section>
    <nav aria-labelledby="footer-follow-heading">
      <h2 id="footer-follow-heading" class={label}>Follow</h2>
      <ul class="grid list-none grid-cols-2 gap-x-8 gap-y-1 p-0 md:grid-cols-1">
        {follow.map(({ label, href }) => <li><a href={href} class={link}>{label}</a></li>)}
      </ul>
      <p class="mt-3 max-w-[22ch] text-xs text-neutral-600 dark:text-muted">Every <a href="/topics/" class={fine}>topic</a> has a feed of its own, too.</p>
    </nav>
    <nav aria-labelledby="footer-browse-heading">
      <h2 id="footer-browse-heading" class={label}>Browse</h2>
      <ul class="grid list-none grid-cols-2 gap-x-8 gap-y-1 p-0 md:grid-cols-1">
        {browse.map(({ label, href }) => <li><a href={href} class={link}>{label}</a></li>)}
        <li><button type="button" data-command-palette-open class={`${link} cursor-pointer`}>Search</button></li>
      </ul>
    </nav>
  </div>
  <div class="border-t border-black/5 dark:border-white/10">
    <p class="px-5 py-5 text-xs text-neutral-600 md:mx-auto md:max-w-(--breakpoint-md) md:px-0 dark:text-muted">Copyright Andrew Lilley Brinker. Made with <Icon name="heart" class="-mt-0.5 !h-3 !w-3" /> in California · <a href="/about/#ai-policy" class={fine}>AI Policy</a> · <a href="/colophon/" class={fine}>Colophon</a></p>
  </div>
</footer>

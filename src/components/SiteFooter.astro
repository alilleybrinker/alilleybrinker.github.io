---
import { getCollection } from 'astro:content';
import Icon from './Icon.astro';
import { byNewest, isListedPost, postPath, topicSlug } from '../lib/site';

// The footer at the bottom of every page, set on a band of its own: who writes
// the site, its feeds, where else to follow along, where to go next, and the
// fine print.
const posts = (await getCollection('blog')).filter(isListedPost).sort(byNewest);
const latest = posts[0];
const latestPath = latest && postPath(latest);
const showLatest = latest && latestPath !== Astro.url.pathname;

// Every feed, for the Feeds menu: all posts, the reading list, and each
// topic's own, the topics with the most posts first. All are Atom.
const topicCounts = new Map<string, number>();
for (const topic of posts.flatMap((post) => post.data.taxonomies.topics)) topicCounts.set(topic, (topicCounts.get(topic) ?? 0) + 1);
const feedGroups = [
  { name: 'All posts', feeds: [{ label: 'All posts', href: '/atom.xml' }] },
  { name: 'Reading', feeds: [{ label: 'Reading', href: '/reading/atom.xml' }] },
  {
    name: 'Topics',
    feeds: [...topicCounts].sort(([, a], [, b]) => b - a).map(([topic, count]) => ({ label: topic, count, href: `/topics/${topicSlug(topic)}/atom.xml` })),
  },
];
const follow = [
  { label: 'Bluesky', href: 'https://bsky.app/profile/alilleybrinker.com' },
  { label: 'Mastodon', href: 'https://hachyderm.io/@alilleybrinker' },
  { label: 'GitHub', href: 'https://github.com/alilleybrinker' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/alilleybrinker' },
];
const browse = [
  { label: 'Posts', href: '/' },
  { label: 'Topics', href: '/topics/' },
  { label: 'Projects', href: '/projects/' },
  { label: 'Talks', href: '/talks/' },
  { label: 'Reading', href: '/reading/' },
  { label: 'About', href: '/about/' },
];
const label = 'mb-3 text-xs font-semibold uppercase tracking-widest text-neutral-600 dark:text-muted';
const link = 'text-black hover:underline dark:text-neutral-100';
const fine = 'whitespace-nowrap underline decoration-rule hover:text-black dark:hover:text-white';
---

<footer transition:name="site-footer" transition:animate="none" class="site-footer bg-footer text-sm leading-6">
  <div class="grid gap-10 px-5 pt-12 pb-10 mx-auto max-w-[calc(var(--breakpoint-md)+2.5rem)] md:grid-cols-[1fr_auto_auto_auto] md:gap-12">
    <section aria-labelledby="footer-about-heading">
      <h2 id="footer-about-heading" class="font-display text-lg font-semibold tracking-tight text-black dark:text-neutral-100">Andrew Lilley Brinker</h2>
      <p class="mt-2 max-w-[34ch] text-neutral-600 dark:text-muted">I’m a Member of Technical Staff at Anthropic. I write about software security, memory safety, Rust, and open source.</p>
      {showLatest && (
        <p class="mt-5">
          <span class={`${label} mb-1 block`}>Latest</span>
          <a href={latestPath} class={link}>{latest.data.title}</a>
        </p>
      )}
    </section>
    <nav aria-labelledby="footer-feeds-heading">
      <h2 id="footer-feeds-heading" class={label}>Feeds</h2>
      <details class="feeds-menu group relative" data-feeds-menu>
        <summary class="flex h-8 w-fit cursor-pointer list-none items-center gap-1.5 rounded-full bg-neutral-500/10 px-3.5 text-neutral-600 hover:bg-neutral-500/15 hover:text-black group-open:bg-neutral-500/15 group-open:text-black focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent dark:text-muted dark:hover:text-white dark:group-open:text-white [&::-webkit-details-marker]:hidden">
          Choose a feed
          <span aria-hidden="true" class="text-[0.7em] transition-transform duration-150 group-open:rotate-180 motion-reduce:transition-none">▾</span>
        </summary>
        <div class="feeds-menu-panel">
          {feedGroups.map((group) => (
            <div role="group" aria-label={group.name}>
              {group.name === 'Topics' && <p class="feeds-menu-group">Topics</p>}
              <ul class="list-none p-0">
                {group.feeds.map((feed) => (
                  <li class="feeds-menu-item">
                    <a href={feed.href} class="feeds-menu-link">
                      <span class="truncate">{feed.label}</span>
                      {'count' in feed && <span class="text-xs tabular-nums text-muted">{feed.count}<span class="sr-only"> posts</span></span>}
                    </a>
                    <button type="button" class="feeds-menu-copy" data-feed-copy={feed.href} aria-label={`Copy the ${feed.label} feed's address`}><span data-label>Copy</span><span aria-hidden="true" data-copied-label>Copied</span></button>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </details>
    </nav>
    <nav aria-labelledby="footer-follow-heading">
      <h2 id="footer-follow-heading" class={label}>Follow</h2>
      <ul class="grid list-none grid-cols-2 gap-x-8 gap-y-1 p-0 md:grid-cols-1">
        {follow.map(({ label, href }) => <li><a href={href} class={link}>{label}</a></li>)}
      </ul>
    </nav>
    <nav aria-labelledby="footer-browse-heading">
      <h2 id="footer-browse-heading" class={label}>Browse</h2>
      <ul class="grid list-none grid-cols-2 gap-x-8 gap-y-1 p-0 md:grid-cols-1">
        {browse.map(({ label, href }) => <li><a href={href} class={link}>{label}</a></li>)}
        <li><button type="button" data-command-palette-open class={`${link} cursor-pointer`}>Search</button></li>
      </ul>
    </nav>
  </div>
  <div class="border-t border-black/5 dark:border-white/10">
    <p class="px-5 py-5 text-xs text-neutral-600 mx-auto max-w-[calc(var(--breakpoint-md)+2.5rem)] dark:text-muted">Copyright Andrew Lilley Brinker. Made with <Icon name="heart" class="-mt-0.5 !h-3 !w-3" /> in California · <a href="/ai/" class={fine}>AI Policy</a> · <a href="/colophon/" class={fine}>Colophon</a></p>
  </div>
</footer>

<script>
  // The Feeds menu closes on Escape or a click outside it, like the site's
  // other menus, and each feed's Copy button puts its full address on the
  // clipboard, which is what a feed reader wants.
  document.addEventListener('astro:page-load', () => {
    const menu = document.querySelector<HTMLDetailsElement>('[data-feeds-menu]');
    if (!menu) return;
    const listeners = new AbortController();
    const { signal } = listeners;
    document.addEventListener('click', async (event) => {
      const target = event.target as Element;
      if (menu.open && !menu.contains(target)) menu.open = false;
      const copy = target.closest<HTMLButtonElement>('[data-feed-copy]');
      if (!copy) return;
      await navigator.clipboard.writeText(new URL(copy.dataset.feedCopy!, location.origin).href);
      copy.setAttribute('data-copied', '');
      setTimeout(() => copy.removeAttribute('data-copied'), 2000);
    }, { signal });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menu.open) {
        menu.open = false;
        menu.querySelector('summary')?.focus();
      }
    }, { signal });
    document.addEventListener('astro:before-swap', () => listeners.abort(), { once: true });
  });
</script>

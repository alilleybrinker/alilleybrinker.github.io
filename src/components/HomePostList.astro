---
import type { Post } from '../lib/site';
import { postDate, postPath, postReadingTime, publicationColors } from '../lib/site';
import Icon from './Icon.astro';

interface Props {
  posts: Post[];
  limit?: number;
  // Where the posts to mark with a star link to, such as those featured in
  // Start Here. Matching on the link covers posts published elsewhere.
  featured?: Set<string>;
  // The level of the years' headings: one below whatever heads the list.
  yearHeading?: 'h2' | 'h3';
}
const { posts, limit, featured, yearHeading: YearHeading = 'h3' } = Astro.props;
const displayed = limit === undefined ? posts : posts.slice(0, limit);
const years = new Map<number, Post[]>();
for (const post of displayed) {
  const year = postDate(post).getUTCFullYear();
  years.set(year, [...(years.get(year) ?? []), post]);
}

---

<div class="mt-10 not-prose">
  {[...years.entries()].map(([year, yearPosts]) => (
    <section class="mb-6">
      <YearHeading class="mb-1 text-sm font-normal text-muted">{year}</YearHeading>
      <ul class="list-none p-0">
        {yearPosts.map((post) => (
          <li>
            <a class="group flex flex-col items-start gap-1 py-1.5 text-black sm:flex-row sm:items-baseline sm:justify-between sm:gap-6 dark:text-white" href={postPath(post)}>
              <span class="inline-flex items-center gap-1"><span class="dither-underline" data-post-title>{post.data.title}</span>{featured?.has(postPath(post)) && <><span aria-hidden="true" title="Featured in Start Here" class="text-muted">★</span><span class="sr-only"> (featured)</span></>}{post.data.publication && <span title={post.data.publicationTitle} class="relative top-px mx-0.5 rounded-sm bg-stone-200/65 px-1.5 py-0.5 font-sans text-xs font-semibold text-stone-700 group-hover:bg-(--publication-color) group-hover:text-white dark:bg-neutral-500/70 dark:text-neutral-200" style={`--publication-color: ${publicationColors[post.data.publication]}`}>{post.data.publication}</span>}{post.data.externalUrl && <><Icon name="arrow-up-right" class="!h-4 !w-4 text-neutral-400 group-hover:text-black dark:text-neutral-500 dark:group-hover:text-white" /><span class="sr-only"> (external article)</span></>}</span>
              <time class="shrink-0 text-sm tabular-nums text-muted" datetime={postDate(post).toISOString()}>{postDate(post).toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' })} / {postReadingTime(post)} min read</time>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</div>

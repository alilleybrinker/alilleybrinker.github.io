---
import type { Post } from '../lib/site';
import { postDate, postPath } from '../lib/site';
import PostRow from './PostRow.astro';

interface Props {
  posts: Post[];
  limit?: number;
  // Where the posts to mark with a star link to, such as those featured in
  // Start Here. Matching on the link covers posts published elsewhere.
  featured?: Set<string>;
  // The level of the years' headings: one below whatever heads the list.
  yearHeading?: 'h2' | 'h3';
}
const { posts, limit, featured, yearHeading: YearHeading = 'h3' } = Astro.props;
const displayed = limit === undefined ? posts : posts.slice(0, limit);
const years = new Map<number, Post[]>();
for (const post of displayed) {
  const year = postDate(post).getUTCFullYear();
  years.set(year, [...(years.get(year) ?? []), post]);
}

---

<div class="mt-10 not-prose">
  {[...years.entries()].map(([year, yearPosts]) => (
    <section class="mb-6">
      <YearHeading class="mb-1 text-sm font-normal text-muted">{year}</YearHeading>
      <ul class="list-none p-0">
        {yearPosts.map((post) => (
          <li><PostRow post={post} featured={featured?.has(postPath(post))} /></li>
        ))}
      </ul>
    </section>
  ))}
</div>

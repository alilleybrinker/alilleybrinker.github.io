---
import Icon from './Icon.astro';
---

<div class="inline-flex items-center md:flex justify-end">
  <button type="button" class="theme-switcher inline-flex size-8 cursor-pointer items-center justify-center rounded-full text-neutral-400 hover:bg-blue-100 hover:text-blue-500 dark:hover:bg-blue-500/25" aria-label="Toggle color theme" title="Toggle color theme">
    <Icon name="sun" class="theme-icon-light" />
    <Icon name="moon" class="theme-icon-dark" />
  </button>
</div>

<script>
  type Theme = 'light' | 'dark';
  const key = 'theme';
  const colorScheme = matchMedia('(prefers-color-scheme: dark)');
  const systemTheme = (): Theme => colorScheme.matches ? 'dark' : 'light';
  const storedTheme = (): Theme | undefined => {
    const theme = localStorage.getItem(key);
    return theme === 'light' || theme === 'dark' ? theme : undefined;
  };
  const resolvedTheme = (): Theme => storedTheme() ?? systemTheme();
  const applyTheme = (theme: Theme) => {
    document.documentElement.classList.toggle('dark', theme === 'dark');
    document.querySelectorAll<HTMLButtonElement>('.theme-switcher').forEach((button) => {
      const isDark = theme === 'dark';
      const target = isDark ? 'light' : 'dark';
      const returnsToSystem = target === systemTheme();
      const action = returnsToSystem ? `Use system theme (${target})` : `Switch to ${target} theme`;
      button.setAttribute('aria-label', action);
      button.title = action;
    });
  };
  const toggleTheme = () => {
    const target = resolvedTheme() === 'dark' ? 'light' : 'dark';
    if (target === systemTheme()) localStorage.removeItem(key);
    else localStorage.setItem(key, target);
    applyTheme(target);
  };

  applyTheme(resolvedTheme());
  document.querySelectorAll<HTMLButtonElement>('.theme-switcher').forEach((button) => button.addEventListener('click', toggleTheme));
  colorScheme.addEventListener('change', () => {
    if (!storedTheme()) applyTheme(systemTheme());
  });
</script>

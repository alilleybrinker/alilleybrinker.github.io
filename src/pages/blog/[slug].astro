---
import { getCollection, render } from 'astro:content';
import Icon from '../../components/Icon.astro';
import PostRow from '../../components/PostRow.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { byNewest, isListedPost, postDate, postPath, postReadingTime, postSlug, postUpdated, topicSlug } from '../../lib/site';
import standardSite from '../../data/standard-site.json';
import { markdownPath } from '../../lib/markdown';

export async function getStaticPaths() {
  return (await getCollection('blog'))
    .filter((post) => !post.data.externalUrl)
    .map((post) => ({ params: { slug: postSlug(post) }, props: { post } }));
}
const { post } = Astro.props;
const { Content, headings } = await render(post);
const date = postDate(post);
const updated = postUpdated(post);
const longDate = (day: Date) => day.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const listedTopics = new Set(
  (await getCollection('blog'))
    .filter(isListedPost)
    .flatMap((candidate) => candidate.data.taxonomies.topics),
);
const topics = post.data.taxonomies.topics.filter((topic) => listedTopics.has(topic));
// Three posts to read next: those sharing the most topics with this one,
// newest first among equals, so posts sharing none fall back to the newest.
const keepReading = (await getCollection('blog'))
  .filter((candidate) => isListedPost(candidate) && candidate.id !== post.id)
  .sort(byNewest)
  .map((candidate, order) => ({ candidate, order, shared: candidate.data.taxonomies.topics.filter((topic) => post.data.taxonomies.topics.includes(topic)).length }))
  .sort((a, b) => b.shared - a.shared || a.order - b.order)
  .slice(0, 3)
  .map(({ candidate }) => candidate);
const readingTime = postReadingTime(post);
const canonical = new URL(postPath(post), Astro.site);
const socialImage = `/social/${postSlug(post)}.png`;
const markdown = markdownPath(post);
const claudePrompt = `I'm reading “${post.data.title}” by Andrew Lilley Brinker. Here is the text: ${new URL(markdown, Astro.site)}\n\nHelp me understand its argument and where it might be weakest.`;
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: date.toISOString(),
  dateModified: (updated ?? date).toISOString(),
  author: {
    '@type': 'Person',
    name: 'Andrew Lilley Brinker',
    url: new URL('/', Astro.site).href,
  },
  mainEntityOfPage: canonical.href,
  image: new URL(socialImage, Astro.site).href,
  articleSection: 'Blog',
  keywords: topics,
};
---

<BaseLayout title={post.data.title} description={post.data.description} canonical={canonical} type="article" socialImage={socialImage} socialImageAlt={post.data.title} structuredData={structuredData} standardDocumentUri={standardSite.documents[postSlug(post)]} markdown={markdown} noindex={post.data.unlisted}>
  <div class="reading-progress" aria-hidden="true"></div>
  <article class="post-body">
    <h1 class="block mb-5 text-3xl md:text-4xl"><span data-page-title class="resolve-in leading-snug block mb-4 font-display [view-transition-name:post-title]">{post.data.title}</span><span class="font-sans flex flex-wrap items-center gap-2 text-sm md:text-base text-muted"><time datetime={date.toISOString().slice(0, 10)}>{longDate(date)}</time>{updated && <><span aria-hidden="true" class="font-black text-muted">·</span><span>Updated <time datetime={updated.toISOString().slice(0, 10)}>{longDate(updated)}</time></span></>}<span aria-hidden="true" class="font-black text-muted">·</span><span>Read in {readingTime} minutes</span>{topics.length > 0 && <><span aria-hidden="true" class="font-black text-muted">·</span><span>Topics: {topics.map((topic, index) => <><a class="!text-muted" href={`/topics/${topicSlug(topic)}/`}>{topic}</a>{index < topics.length - 1 && ', '}</>)}</span></>}</span></h1>
    <p class="print-only">{canonical.href}</p>
    {post.data.extra.toc && headings.length > 0 && (
      <div id="table-of-contents-sentinel" aria-hidden="true"></div>
      <details id="table-of-contents" aria-label="Table of contents" class="group not-prose sticky top-0 z-10 mb-10 w-full font-sans text-sm">
        <summary class="flex w-full cursor-pointer list-none items-center justify-between gap-2 px-5 py-3 font-medium text-neutral-700 [&::-webkit-details-marker]:hidden dark:text-neutral-200 dark:open:!text-neutral-100">
          <span class="flex min-w-0 items-baseline gap-2"><span class="toc-title shrink-0">Table of contents</span><span data-toc-current class="toc-current truncate"></span></span>
          <span aria-hidden="true" class="text-sm transition-transform duration-200 ease-out group-open:rotate-180">▾</span>
        </summary>
        <nav class="max-h-[calc(100vh-1rem)] w-full overflow-y-auto px-5 pb-6" aria-label="Article sections">
          <ol class="list-none space-y-2 text-neutral-700 dark:group-open:!text-neutral-200">
            {headings.map((heading) => (
              <li class:list={{ 'flex gap-2': true, 'ml-4': heading.depth === 3, 'ml-8': heading.depth >= 4 }}>
                {heading.depth > 2 && <span aria-hidden="true" class="text-muted">↳</span>}
                <a class="no-underline hover:underline" href={`#${heading.slug}`}>{heading.text}</a>
              </li>
            ))}
          </ol>
        </nav>
      </details>
    )}
    <Content />
    <div class="post-end relative mt-20">
      <div class="post-end-field" aria-hidden="true" style={`--post-end-field: url(/field/${postSlug(post)}.svg)`}></div>
      <aside aria-labelledby="share-post-heading" class="not-prose relative rounded-2xl border border-panel-border bg-panel p-6 text-base leading-normal dark:border-neutral-700 dark:bg-neutral-800 sm:p-8">
        <div class="flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
          <div>
            <h2 id="share-post-heading" class="font-display text-xl font-semibold text-neutral-900 dark:text-neutral-100">Enjoyed this post?</h2>
            <p class="mt-2 text-neutral-600 dark:text-neutral-300">Share it with someone who might find it useful.</p>
            <p class="mt-1 text-neutral-600 dark:text-neutral-300">For new posts, follow on <a href="https://bsky.app/profile/alilleybrinker.com" class="underline decoration-rule hover:text-neutral-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neutral-900 dark:hover:text-white">Bluesky</a> or subscribe by <a href="/rss.xml" class="underline decoration-rule hover:text-neutral-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neutral-900 dark:hover:text-white">RSS</a>.</p>
          </div>
          <div class="flex flex-col items-center gap-3 sm:items-end">
            <a
              href={`https://bsky.app/intent/compose?text=${encodeURIComponent(`${post.data.title} by @alilleybrinker.com ${new URL(postPath(post), Astro.site)}`)}`}
              class="inline-flex shrink-0 items-center justify-center gap-2 rounded-lg bg-accent px-5 py-3 font-semibold text-white no-underline transition-[filter] hover:brightness-90 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
            >
              <Icon name="bluesky" class="!h-5 !w-5" />
              Share on Bluesky
            </a>
            <p class="text-sm text-neutral-600 dark:text-neutral-300">
              <button id="copy-link" class="cursor-pointer underline decoration-rule hover:text-neutral-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neutral-900 dark:hover:text-white" type="button">Copy link</button>
              <span aria-hidden="true"> · </span>
              <a href={`mailto:?subject=${encodeURIComponent(post.data.title)}&body=${encodeURIComponent(`${post.data.title}\n\n${new URL(postPath(post), Astro.site)}`)}`} class="underline decoration-rule hover:text-neutral-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neutral-900 dark:hover:text-white">Share by email</a>
            </p>
            <p class="text-sm text-neutral-600 dark:text-neutral-300">
              <button id="copy-markdown" data-markdown={markdown} class="cursor-pointer underline decoration-rule hover:text-neutral-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neutral-900 dark:hover:text-white" type="button">Copy as Markdown</button>
              <span aria-hidden="true"> · </span>
              <a href={`https://claude.ai/new?q=${encodeURIComponent(claudePrompt)}`} class="underline decoration-rule hover:text-neutral-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neutral-900 dark:hover:text-white">Discuss with Claude</a>
            </p>
          </div>
        </div>
        <p id="copy-link-status" class="sr-only" aria-live="polite"></p>
      </aside>
    </div>
    <section aria-labelledby="keep-reading-heading" class="not-prose mt-16">
      <h2 id="keep-reading-heading" class="mb-3 font-sans text-sm font-semibold uppercase tracking-widest text-muted">Keep reading</h2>
      <ul class="list-none p-0">
        {keepReading.map((next) => <li><PostRow post={next} withYear /></li>)}
      </ul>
    </section>
  </article>
  <script>
    // A section heading's link (heading-links.ts) goes to its section as any
    // link would, and also copies the section's address, saying so briefly.
    document.addEventListener('click', (event) => {
      const link = (event.target as Element).closest?.<HTMLAnchorElement>('.heading-link');
      if (!link || !navigator.clipboard) return;
      navigator.clipboard.writeText(link.href).then(() => {
        link.dataset.copied = '';
        setTimeout(() => delete link.dataset.copied, 1500);
      }, () => {});
    });

    // Runs on the first load and after every client-side navigation to a post.
    document.addEventListener('astro:page-load', () => {
      const tableOfContents = document.querySelector<HTMLDetailsElement>('#table-of-contents');
      const tableOfContentsSentinel = document.querySelector('#table-of-contents-sentinel');

      if (tableOfContents && tableOfContentsSentinel) {
        // Choosing a section closes the list before the jump, so the list
        // doesn't cover the section, and the jump lands where it should.
        tableOfContents.querySelector('nav')?.addEventListener('click', (event) => {
          if ((event.target as Element).closest('a')) tableOfContents.open = false;
        });

        // The table of contents is stuck once the spot it would otherwise sit in
        // has scrolled above the viewport, which an observer reports without any
        // work on each scroll.
        const stuck = new IntersectionObserver(([entry]) => {
          tableOfContents.classList.toggle('toc-is-stuck', !entry.isIntersecting && entry.boundingClientRect.top < 0);
        });
        // When stuck, its background grows by 1.25rem on each side. That growth
        // is a scale, so it animates without layout, and needs the current width.
        const width = new ResizeObserver(([entry]) => {
          const boxWidth = entry.borderBoxSize[0].inlineSize;
          tableOfContents.style.setProperty('--toc-stuck-scale', String((boxWidth + 40) / boxWidth));
        });
        stuck.observe(tableOfContentsSentinel);
        width.observe(tableOfContents);

        // The section being read is the last whose heading has passed the top
        // third of the window. It's marked in the list, and named in the label
        // while the table of contents is stuck. Headings are only measured when
        // one crosses that line, or when a scroll ends, never on each frame.
        const links = new Map([...tableOfContents.querySelectorAll<HTMLAnchorElement>('nav a')].map((link) => [decodeURIComponent(link.hash.slice(1)), link]));
        const headings = [...document.querySelectorAll<HTMLElement>('.post-body :is(h2, h3, h4)[id]')].filter((heading) => links.has(heading.id));
        const current = tableOfContents.querySelector<HTMLElement>('[data-toc-current]')!;
        let reading: HTMLAnchorElement | undefined;
        const update = () => {
          const line = innerHeight / 3;
          const heading = headings.findLast((candidate) => candidate.getBoundingClientRect().top <= line);
          const link = heading && links.get(heading.id);
          if (link === reading) return;
          reading?.removeAttribute('aria-current');
          link?.setAttribute('aria-current', 'location');
          current.textContent = link?.textContent ?? '';
          reading = link;
        };
        const crossing = new IntersectionObserver(update, { rootMargin: '0px 0px -67% 0px' });
        headings.forEach((heading) => crossing.observe(heading));
        addEventListener('scrollend', update);
        update();

        document.addEventListener('astro:before-swap', () => {
          stuck.disconnect();
          width.disconnect();
          crossing.disconnect();
          removeEventListener('scrollend', update);
        }, { once: true });
      }

      const copyLinkStatus = document.querySelector<HTMLElement>('#copy-link-status');
      const copyButton = (button: HTMLButtonElement | null, text: () => Promise<string>, copied: string, failed: string) => {
        const defaultLabel = button?.textContent;
        button?.addEventListener('click', async () => {
          try {
            // Safari only allows clipboard writes started synchronously from the
            // click, so hand it a pending item rather than awaiting the text first.
            const blob = text().then((value) => new Blob([value], { type: 'text/plain' }));
            await navigator.clipboard.write([new ClipboardItem({ 'text/plain': blob })]);
            button.textContent = 'Copied!';
            copyLinkStatus!.textContent = copied;
            window.setTimeout(() => {
              button.textContent = defaultLabel;
            }, 2_000);
          } catch {
            copyLinkStatus!.textContent = failed;
          }
        });
      };

      const copyMarkdown = document.querySelector<HTMLButtonElement>('#copy-markdown');
      copyButton(
        document.querySelector<HTMLButtonElement>('#copy-link'),
        async () => window.location.href,
        'Post link copied to the clipboard.',
        'Could not copy the link. Please copy it from your browser’s address bar.',
      );
      copyButton(
        copyMarkdown,
        () => fetch(copyMarkdown!.dataset.markdown!).then((response) => {
          if (!response.ok) throw new Error(`HTTP ${response.status}`);
          return response.text();
        }),
        'Post copied to the clipboard as Markdown.',
        'Could not copy the post as Markdown.',
      );

      // With sidenotes showing, a footnote reference points at its sidenote,
      // which flashes, rather than jumping to the hidden list at the end.
      const sidenotes = matchMedia('(min-width: 1100px)');
      document.querySelectorAll<HTMLAnchorElement>('.post-body a[data-footnote-ref]').forEach((reference) => {
        reference.addEventListener('click', (event) => {
          const sidenote = document.querySelector<HTMLElement>(`[data-sidenote="${reference.hash.slice(1)}"]`);
          if (!sidenotes.matches || !sidenote) return;
          event.preventDefault();
          sidenote.dataset.flash = '';
          window.setTimeout(() => delete sidenote.dataset.flash, 900);
        });
      });

      // Each code block gets a copy button. The wrapper has no border or
      // padding, so the block's margins collapse through it and the button
      // sits in the block's own corner rather than scrolling with its code.
      document.querySelectorAll<HTMLPreElement>('.post-body pre.astro-code').forEach((pre) => {
        const block = document.createElement('div');
        block.className = 'code-block';
        pre.replaceWith(block);
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'code-copy cursor-pointer rounded-full bg-white px-3 py-1 font-sans text-xs text-neutral-600 ring-1 ring-black/5 hover:text-black dark:bg-neutral-700 dark:text-neutral-200 dark:ring-white/10 dark:hover:text-white';
        button.textContent = 'Copy';
        button.setAttribute('aria-label', 'Copy code');
        block.append(pre, button);
        copyButton(button, async () => pre.innerText, 'Code copied to the clipboard.', 'Could not copy the code.');
      });
    });
  </script>
</BaseLayout>

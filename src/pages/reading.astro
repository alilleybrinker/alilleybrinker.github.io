---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getReadingItems } from "../lib/bluesky";

const items = await getReadingItems();
const formatDate = (date: string) =>
    new Intl.DateTimeFormat("en-US", {
        day: "numeric",
        month: "short",
        year: "numeric",
        timeZone: "UTC",
    }).format(new Date(date));
const updatedAt = new Date();
const formatUpdatedAt = new Intl.DateTimeFormat("en-US", {
    day: "numeric",
    hour: "numeric",
    minute: "2-digit",
    month: "short",
    timeZone: "UTC",
    timeZoneName: "short",
    year: "numeric",
});
// The posts that said something about the link, newest first. When there's
// more than one, each note carries its post's date.
const notesOf = (item: (typeof items)[number]) => item.mentions.filter((mention) => mention.noteHtml);
const years = new Map<number, typeof items>();
for (const item of items) {
    const year = new Date(item.mentions[0].publishedAt).getUTCFullYear();
    years.set(year, [...(years.get(year) ?? []), item]);
}
---

<BaseLayout
    title="Reading"
    description="Articles Andrew Lilley Brinker has shared on Bluesky."
    canonical={new URL("/reading/", Astro.site)}
    feed="/reading/rss.xml"
    socialImage="/social/reading.png"
    socialImageAlt="Reading"
>
    <header>
        <h1>Reading</h1>
        <p>
            An experimental feed of articles I&rsquo;ve shared on <a
                href="https://bsky.app/profile/alilleybrinker.com">Bluesky</a
            >.
        </p>
    </header>
    <p class="!-mt-4 text-sm text-muted">
        Last updated{" "}
        <time datetime={updatedAt.toISOString()}>{formatUpdatedAt.format(updatedAt)}</time>
    </p>

    {
        items.length > 0 ? (
            <div class="not-prose mt-14">
                {[...years.entries()].map(([year, yearItems]) => (
                    <section class="mb-10">
                        <h2 class="mb-2 text-sm font-normal text-muted">
                            {year}
                        </h2>
                        <ol class="list-none p-0">
                            {yearItems.map((item) => (
                                <li class="reading-link-item group">
                                    <article>
                                        <div class="reading-link-preview">
                                            <h3 class="reading-link-preview-title">
                                                <a href={item.url}>
                                                    <span
                                                        class="dither-underline"
                                                        set:html={
                                                            item.articleTitleHtml
                                                        }
                                                    />
                                                </a>
                                            </h3>
                                            {item.articlePublishedAt && (
                                                <time
                                                    class="reading-link-preview-date"
                                                    datetime={
                                                        item.articlePublishedAt
                                                    }
                                                >
                                                    {formatDate(
                                                        item.articlePublishedAt,
                                                    )}
                                                </time>
                                            )}
                                        </div>
                                        <div class="mt-1 flex items-baseline gap-x-2 text-xs text-muted">
                                            <span>{item.rootDomain}</span>
                                            <span aria-hidden="true">·</span>
                                            <span
                                                class="inline-flex items-center"
                                                title="Bluesky posts"
                                            >
                                                <svg
                                                    class="reading-bluesky-icon"
                                                    viewBox="-24 -24 560 560"
                                                    aria-hidden="true"
                                                >
                                                    <path d="M111.8 62.2C170.2 105.9 233 194.7 256 242.4c23-47.6 85.8-136.4 144.2-180.2c42.1-31.6 110.3-56 110.3 21.8c0 15.5-8.9 130.5-14.1 149.2C478.2 298 412 314.6 353.1 304.5c102.9 17.5 129.1 75.5 72.5 133.5c-107.4 110.2-154.3-27.6-166.3-62.9l0 0c-1.7-4.9-2.6-7.8-3.3-7.8s-1.6 3-3.3 7.8l0 0c-12 35.3-59 173.1-166.3 62.9c-56.5-58-30.4-116 72.5-133.5C100 314.6 33.8 298 15.7 233.1C10.4 214.4 1.5 99.4 1.5 83.9c0-77.8 68.2-53.4 110.3-21.8z" />
                                                </svg>
                                                <span class="sr-only">
                                                    Bluesky posts
                                                </span>
                                            </span>
                                            <ul class="flex list-none flex-wrap gap-x-3 gap-y-1 p-0">
                                                {item.mentions.map(
                                                    (mention) => (
                                                        <li>
                                                            <a
                                                                href={
                                                                    mention.blueskyUrl
                                                                }
                                                                class="hover:underline"
                                                            >
                                                                <time
                                                                    datetime={
                                                                        mention.publishedAt
                                                                    }
                                                                >
                                                                    {formatDate(
                                                                        mention.publishedAt,
                                                                    )}
                                                                </time>
                                                            </a>
                                                        </li>
                                                    ),
                                                )}
                                            </ul>
                                        </div>
                                        {notesOf(item).length > 0 && (
                                            <div class="reading-notes">
                                                {notesOf(item).map((mention) => (
                                                    <div class="reading-note">
                                                        {notesOf(item).length > 1 && (
                                                            <a class="reading-note-date" href={mention.blueskyUrl}>
                                                                <time datetime={mention.publishedAt}>{formatDate(mention.publishedAt)}</time>
                                                            </a>
                                                        )}
                                                        <Fragment set:html={mention.noteHtml} />
                                                    </div>
                                                ))}
                                            </div>
                                        )}
                                    </article>
                                </li>
                            ))}
                        </ol>
                    </section>
                ))}
            </div>
        ) : (
            <p>No links are available right now.</p>
        )
    }
</BaseLayout>

<style is:global>
    .reading-bluesky-icon {
        width: 0.875rem;
        height: 0.875rem;
        color: rgb(191 191 191);
        fill: none;
        overflow: visible;
        stroke: currentColor;
        stroke-linejoin: round;
        stroke-width: 28;
        transform: translateY(2px);
    }

    .dark .reading-bluesky-icon {
        color: rgb(143 143 143);
    }

    .reading-link-preview-date {
        margin: 0;
        color: var(--color-muted);
        font-size: 0.875rem;
        line-height: 1.25rem;
        font-variant-numeric: tabular-nums;
    }

    .reading-link-preview-title {
        margin: 0;
        color: black;
        font-family: var(--font-sans);
        font-size: 1.125rem;
        font-weight: 500;
        line-height: 1.35;
    }

    .reading-link-preview-title a {
        color: inherit;
        font-weight: inherit;
    }

    /* Each link is its own block: room around it, and a hairline between it
       and the next, since a note can make one run several lines. */
    .reading-link-item {
        position: relative;
        padding-block: 1.25rem;
    }

    .reading-link-item + .reading-link-item {
        border-top: 1px solid var(--color-panel-border);
    }

    .dark .reading-link-item + .reading-link-item {
        border-top-color: var(--color-neutral-800);
    }

    .reading-link-preview-title a::after {
        position: absolute;
        z-index: 0;
        inset: 0;
        content: "";
    }

    .reading-link-item > article > div + div {
        position: relative;
        z-index: 1;
    }

    /* What Andrew said when he shared the link, from his Bluesky post: his
       own words, so in the running text's color, held to the text measure.
       Each post's note is its own block. */
    .reading-notes {
        display: grid;
        gap: 0.75rem;
        max-width: 34em;
        margin-top: 0.75rem;
        padding-left: 0.875rem;
        border-left: 2px solid var(--color-neutral-300);
        color: oklch(0.374 0.01 67.558);
        font-size: 0.9375rem;
        line-height: 1.6;
        overflow-wrap: anywhere;
    }

    .reading-note {
        display: grid;
        gap: 0.5rem;
    }

    .reading-note p {
        margin: 0;
    }

    .reading-note .reading-note-date {
        margin-bottom: -0.375rem;
        color: var(--color-muted);
        font-size: 0.75rem;
        text-decoration: none;
        font-variant-numeric: tabular-nums;
    }

    .reading-note .reading-note-date:hover {
        text-decoration: underline;
    }

    .reading-note a {
        color: inherit;
        text-decoration: underline;
        text-decoration-color: var(--color-rule);
        text-underline-offset: 0.2em;
    }

    .reading-note a:hover {
        text-decoration-color: currentColor;
    }

    .dark .reading-notes {
        border-left-color: var(--color-neutral-700);
        color: oklch(0.869 0.005 56.366);
    }

    /* Code in a title sits on a chip, in ink. */
    .reading-link-preview-title code {
        border-radius: 0.25rem;
        background: rgb(231 229 228);
        color: rgb(23 23 23);
        padding: 0.1rem 0.25rem;
        font-family: var(--font-mono);
        font-size: 0.875em;
    }

    @media (min-width: 40rem) {
        .reading-link-preview {
            display: flex;
            align-items: baseline;
            justify-content: space-between;
            gap: 1.5rem;
        }

        .reading-link-preview-title {
            min-width: 0;
        }

        .reading-link-preview-date {
            flex-shrink: 0;
        }
    }

    .dark .reading-link-preview-title {
        color: white;
    }

    .dark .reading-link-preview-title code {
        background: rgb(64 64 64);
        color: white;
    }
</style>

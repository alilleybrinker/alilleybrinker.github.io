---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import HomePostList from '../components/HomePostList.astro';
import Icon from '../components/Icon.astro';
import { byNewest, isListedPost, publicationColors, postDate, postPath, postReadingTime, postSlug, readingTimeStrength, topicSlug } from '../lib/site';
const allPosts = await getCollection('blog');
const posts = allPosts.filter(isListedPost).sort(byNewest);
const topics = Object.entries(
  posts.flatMap((post) => post.data.taxonomies.topics).reduce<Record<string, number>>(
    (counts, topic) => ({ ...counts, [topic]: (counts[topic] ?? 0) + 1 }),
    {},
  ),
).sort(([, countA], [, countB]) => countB - countA);
const startHere = [
  {
    slug: 'memory-safety-for-skeptics-in-the-acm-queue',
    title: 'Memory Safety for Skeptics',
    href: 'https://cacm.acm.org/practice/memory-safety-for-skeptics/',
    external: true,
    publication: 'CACM',
    publicationTitle: 'Communications of the ACM',
    date: new Date('2026-01-28T12:00:00Z'),
    readingTime: 30,
  },
  {
    slug: 'open-source-software-and-corporate-influence',
    title: 'Open Source Software and Corporate Influence',
  },
  {
    slug: 'cpp-must-become-safer',
    title: 'C++ Must Become Safer',
  },
];
const startHerePosts = startHere.map((entry) => {
  const post = allPosts.find((candidate) => postSlug(candidate) === entry.slug);
  if (!post) throw new Error(`Missing Start Here post: ${entry.slug}`);
  const date = 'date' in entry ? entry.date : postDate(post);
  const readingTime = 'readingTime' in entry ? entry.readingTime : postReadingTime(post);
  return {
    ...entry,
    href: 'href' in entry ? entry.href : postPath(post),
    description: post.data.description,
    date,
    readingTime,
    readingStrength: readingTimeStrength(readingTime),
  };
});
const otherPosts = posts;
const lede = 'I’m a Member of Technical Staff at Anthropic. I write about software security, memory safety, Rust, and open source.';
---

<BaseLayout title="Software Security Engineer" description={lede} socialImage="/social/home.png" socialImageAlt="Software Security Engineer">
  <p class="!mb-12 font-medium text-black dark:text-neutral-100 [&_a]:!font-medium">I’m a Member of Technical Staff at <a href="https://www.anthropic.com">Anthropic</a>. I write about software security, memory safety, Rust, and open source.</p>
  <section aria-labelledby="start-here-heading" data-no-preview class="not-prose mb-16">
    <h2 id="start-here-heading" class="mb-6 font-sans text-sm font-semibold uppercase tracking-widest text-muted">Start Here</h2>
    <ul class="list-none space-y-6 p-0">
      {startHerePosts.map((post) => (
        <li>
          <a class="group block py-2 text-black dark:text-white" href={post.href}>
            <span class="flex flex-col items-start gap-1 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
              <span class="inline-flex items-center gap-1"><span class="group-hover:underline" data-post-title>{post.title}</span>{'publication' in post && <span title={post.publicationTitle} class="relative top-px mx-0.5 rounded-sm bg-stone-200/65 px-1.5 py-0.5 font-sans text-xs font-semibold text-stone-700 group-hover:bg-(--publication-color) group-hover:text-white dark:bg-neutral-500/70 dark:text-neutral-200" style={`--publication-color: ${publicationColors[post.publication]}`}>{post.publication}</span>}{post.external && <><Icon name="arrow-up-right" class="!h-4 !w-4 text-neutral-400 group-hover:text-black dark:text-neutral-500 dark:group-hover:text-white" /><span class="sr-only"> (external article)</span></>}</span>
              <time class="shrink-0 text-sm tabular-nums text-muted" datetime={post.date.toISOString()}>{post.date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' })} / <span class="reading-time" style={`--reading-time-strength: ${post.readingStrength}`}>{post.readingTime} min read</span></time>
            </span>
            {post.description && <span class="mt-1 block max-w-[34rem] text-sm leading-relaxed text-muted">{post.description}</span>}
          </a>
        </li>
      ))}
    </ul>
  </section>
  <section aria-labelledby="blog-heading" class="not-prose">
    <div class="flex items-baseline gap-6">
      <h2 id="blog-heading" class="font-sans text-sm font-semibold uppercase tracking-widest text-muted">Blog</h2>
      <details class="topics-menu group relative text-sm">
        <summary class="flex cursor-pointer list-none items-baseline gap-1.5 rounded text-muted hover:text-black focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent dark:hover:text-white [&::-webkit-details-marker]:hidden">
          Topics
          <span aria-hidden="true" class="text-[0.7em] transition-transform duration-150 group-open:rotate-180 motion-reduce:transition-none">▾</span>
        </summary>
        <ul class="absolute left-0 z-30 mt-2 min-w-60 list-none rounded-3xl bg-white p-1.5 shadow-[0_12px_32px_-16px_rgb(0_0_0/0.25)] ring-1 ring-black/5 dark:bg-neutral-800 dark:ring-white/10">
          {topics.map(([topic, count]) => (
            <li>
              <a class="flex items-baseline justify-between gap-6 rounded-full px-4 py-1.5 text-black hover:bg-neutral-500/10 dark:text-neutral-100" href={`/topics/${topicSlug(topic)}/`}>
                {topic}
                <span class="text-xs tabular-nums text-muted">{count}<span class="sr-only"> posts</span></span>
              </a>
            </li>
          ))}
        </ul>
      </details>
      <div class="ml-auto flex items-center gap-3 self-center">
        <a href="/rss.xml" aria-label="RSS feed" class="text-neutral-400 hover:text-black dark:hover:text-white"><Icon name="rss" class="!h-5 !w-5" /></a>
        <a href="https://standard-reader.app/p/did:plc:geozyv62fx63m7jhr4eraubc/alilleybrinker-site" aria-label="Read this publication on Standard Reader" class="text-neutral-400 hover:text-black dark:hover:text-white"><span aria-hidden="true" class="block h-5 w-5 bg-current [mask-image:url('/icons/standard-site-logo.svg')] [mask-position:center] [mask-repeat:no-repeat] [mask-size:contain]"></span></a>
      </div>
    </div>
    <HomePostList posts={otherPosts} featured={new Set(startHerePosts.map((post) => post.href))} />
  </section>
</BaseLayout>

<script>
  // The topics menu closes on Escape or a click anywhere outside it, like any
  // other menu.
  document.addEventListener('astro:page-load', () => {
    const menu = document.querySelector<HTMLDetailsElement>('.topics-menu');
    if (!menu) return;
    const listeners = new AbortController();
    document.addEventListener('click', (event) => {
      if (menu.open && !menu.contains(event.target as Node)) menu.open = false;
    }, { signal: listeners.signal });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menu.open) {
        menu.open = false;
        menu.querySelector('summary')?.focus();
      }
    }, { signal: listeners.signal });
    document.addEventListener('astro:before-swap', () => listeners.abort(), { once: true });
  });
</script>

---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostRow from '../../components/PostRow.astro';
import { ditherPath, fieldFor, fieldValue, smoothstep } from '../../lib/dither-pattern';
import { byNewest, isListedPost } from '../../lib/site';
import { relatedPosts, talkDate, talkPath, talks, talkSlug, youtubeId, type Talk } from '../../lib/talks';

export function getStaticPaths() {
  return talks.map((talk) => ({ params: { slug: talkSlug(talk) }, props: { talk } }));
}
const { talk } = Astro.props as { talk: Talk };
const path = talkPath(talk);
const date = talkDate(talk);
const longDate = date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const posts = (await getCollection('blog')).filter((post) => isListedPost(post) && !post.data.externalUrl).sort(byNewest);
const related = relatedPosts(talk, posts);
const others = talks.filter((other) => other !== talk);
const video = youtubeId(talk.video_link);

// The talk's plate: its own field, as the project plates and posts have, in
// cells of the page's dither, drawn across a 16:9 frame.
const columns = 272;
const rows = 153;
const shape = fieldFor(path);
const plate = ditherPath(columns, rows, 1, (u, v) => 0.4 * smoothstep(0.1, 1.2, fieldValue(shape, u, v, columns, rows) + 0.25));

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: talk.title,
  description: talk.description,
  startDate: talk.date,
  url: new URL(path, Astro.site).href,
  ...(talk.event_link && { superEvent: { '@type': 'Event', name: talk.event, url: talk.event_link } }),
  performer: { '@type': 'Person', name: 'Andrew Lilley Brinker', url: new URL('/', Astro.site).href },
  ...(talk.video_link && { recordedIn: { '@type': 'VideoObject', name: talk.title, url: talk.video_link } }),
};
---

<BaseLayout title={talk.title} description={talk.description} structuredData={structuredData} socialImage={`/social/talk-${talkSlug(talk)}.png`} socialImageAlt={talk.title}>
  <article class="post-body talk">
    <h1 class="block mb-5 text-3xl md:text-4xl"><span data-page-title class="resolve-in leading-[1.15] block mb-4 font-display">{talk.title}</span><span class="font-sans flex flex-wrap items-center gap-2 text-sm md:text-base text-muted"><span>{talk.type === 'panel' ? 'Panel at' : 'Talk at'} {talk.event_link ? <a class="!text-muted" href={talk.event_link}>{talk.event}</a> : talk.event}</span><span aria-hidden="true" class="font-black text-muted">·</span><time datetime={talk.date}>{longDate}</time></span></h1>
    {talk.description && <p class="talk-lede">{talk.description}</p>}

    <figure class="talk-plate not-prose" data-talk-plate data-video={video}>
      <svg class="talk-plate-field" viewBox={`0 0 ${columns} ${rows}`} preserveAspectRatio="xMidYMid slice" shape-rendering="crispEdges" aria-hidden="true"><path d={plate} fill="currentColor" /></svg>
      {video ? (
        <a class="talk-plate-play share-action bg-accent font-semibold text-white hover:brightness-90" href={talk.video_link} data-talk-play>
          <svg viewBox="0 0 16 16" class="h-4 w-4" aria-hidden="true"><path d="M4 2.5v11l9-5.5z" fill="currentColor" /></svg>
          Play the recording
        </a>
      ) : talk.slides_link && (
        <a class="talk-plate-play share-action bg-accent font-semibold text-white hover:brightness-90" href={talk.slides_link}>View the slides</a>
      )}
    </figure>

    <div class="not-prose mt-5 flex flex-wrap gap-2 text-sm">
      {video && talk.slides_link && <a class="share-action share-action-quiet" href={talk.slides_link}>Slides</a>}
      {video && <a class="share-action share-action-quiet" href={talk.video_link}>Watch on YouTube</a>}
      {talk.talk_link && <a class="share-action share-action-quiet" href={talk.talk_link}>In the program</a>}
    </div>

    {related.length > 0 && (
      <section aria-labelledby="talk-writing-heading" class="not-prose mt-16">
        <h2 id="talk-writing-heading" class="mb-3 font-sans text-sm font-semibold uppercase tracking-widest text-muted">Writing on this</h2>
        <ul class="list-none p-0">
          {related.map((post) => <li><PostRow post={post} withYear /></li>)}
        </ul>
      </section>
    )}

    <section aria-labelledby="talk-others-heading" class="not-prose mt-16">
      <h2 id="talk-others-heading" class="mb-3 font-sans text-sm font-semibold uppercase tracking-widest text-muted">Other talks</h2>
      <ul class="list-none p-0">
        {others.map((other) => (
          <li>
            <a class="group flex flex-col items-start gap-1 py-1.5 text-black sm:flex-row sm:items-baseline sm:justify-between sm:gap-6 dark:text-white" href={talkPath(other)}>
              <span class="dither-underline">{other.title}</span>
              <span class="shrink-0 text-sm text-muted">{other.event}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </article>
</BaseLayout>

<script>
  // The recording loads only when asked for, from YouTube's privacy-enhanced
  // domain, in place of the plate; until then the page makes no request to
  // YouTube. Without scripts, the button is a link to the video.
  document.addEventListener('click', (event) => {
    const play = (event.target as Element).closest<HTMLAnchorElement>('[data-talk-play]');
    const plate = play?.closest<HTMLElement>('[data-talk-plate]');
    if (!play || !plate?.dataset.video || event.metaKey || event.ctrlKey || event.shiftKey) return;
    event.preventDefault();
    const frame = Object.assign(document.createElement('iframe'), {
      src: `https://www.youtube-nocookie.com/embed/${plate.dataset.video}?autoplay=1&rel=0`,
      title: document.querySelector('[data-page-title]')?.textContent ?? 'Recording',
      allow: 'autoplay; encrypted-media; picture-in-picture; fullscreen',
      allowFullscreen: true,
    });
    frame.className = 'talk-plate-video';
    plate.replaceChildren(frame);
    frame.focus();
  });
</script>

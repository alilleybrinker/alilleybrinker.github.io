<BaseLayout title="Page Not Found" description="There’s nothing at this address.">
  <h1>Page Not Found</h1>
  <p>There’s nothing at this address. The page may have moved, or the link may have a typo.</p>
  <p>Try <button type="button" data-command-palette-open class="cursor-pointer text-black underline decoration-rule hover:decoration-black dark:text-white dark:hover:decoration-white">searching the site</button>, or start from <a href="/">the home page</a>.</p>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import { standardReaderUrl } from '../lib/site';
---

<BaseLayout
  title="Colophon"
  description="How Andrew Lilley Brinker’s website is built and published."
  socialImage="/social/colophon.png"
  socialImageAlt="Colophon"
>
  <h1>Colophon</h1>
  <p>
    This site is built with <a href="https://astro.build/">Astro</a>{" "}
    and <a href="https://tailwindcss.com/">Tailwind CSS</a>.
  </p>
  <p>
    Its typography uses <a href="https://fonts.google.com/specimen/Public+Sans">Public Sans</a>{" "}
    for sans-serif text and{" "}
    <a href="https://fonts.google.com/specimen/Bricolage+Grotesque">Bricolage Grotesque</a>{" "}
    for titles.
  </p>
  <p>
    Every article is cross-published in{" "}
    <a href="https://standard.site/">standard.site</a>{" "}format to my PDS.
  </p>
  <p>
    You can{" "}<a href={standardReaderUrl}>view it in Standard Reader</a>.
  </p>
</BaseLayout>
